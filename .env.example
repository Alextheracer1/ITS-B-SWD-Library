# ==============================================================================
# LiBros Bibliothekssystem - Umgebungsvariablen-Konfiguration
# ==============================================================================

# Django Basis-Konfiguration
DJANGO_SECRET_KEY=django-insecure-libros-library-project-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# SQL-Datenbankanbindung (Verantwortlich: Marcel Kitzmantel)
# ==============================================================================
# Auswahl der Datenbank über DB_ENGINE:
# - 'sqlite'     : Standard SQLite-Datenbank (lokale Datei, keine Installation nötig)
# - 'postgresql' : PostgreSQL-Server
# - 'mysql'      : MySQL / MariaDB-Server

DB_ENGINE=sqlite

# Konfiguration für PostgreSQL / MySQL (nur erforderlich, wenn DB_ENGINE != sqlite):
DB_NAME=libros_db
DB_USER=libros_user
DB_PASSWORD=secret_password
DB_HOST=localhost
DB_PORT=5432
